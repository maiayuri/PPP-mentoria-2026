{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Controle de Gastos Pessoais",
    "description": "API REST para cadastro de usuários e controle de despesas pessoais, com resumo mensal por categoria.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "Ambiente local" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegistroInput": {
        "type": "object",
        "required": ["nome", "email", "senha"],
        "properties": {
          "nome": { "type": "string", "example": "Yuri Maia" },
          "email": { "type": "string", "format": "email", "example": "yuri@exemplo.com" },
          "senha": { "type": "string", "format": "password", "example": "senha123" }
        }
      },
      "Usuario": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "LoginInput": {
        "type": "object",
        "required": ["email", "senha"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "yuri@exemplo.com" },
          "senha": { "type": "string", "format": "password", "example": "senha123" }
        }
      },
      "TokenResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." }
        }
      },
      "DespesaInput": {
        "type": "object",
        "required": ["valor", "categoria", "data"],
        "properties": {
          "valor": { "type": "number", "example": 89.9 },
          "categoria": {
            "type": "string",
            "enum": ["alimentacao", "transporte", "moradia", "saude", "lazer", "educacao", "outros"],
            "example": "alimentacao"
          },
          "data": { "type": "string", "format": "date", "example": "2026-08-14" },
          "descricao": { "type": "string", "example": "Almoço com a equipe" }
        }
      },
      "Despesa": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "usuarioId": { "type": "string", "format": "uuid" },
          "valor": { "type": "number", "example": 89.9 },
          "categoria": { "type": "string", "example": "alimentacao" },
          "data": { "type": "string", "format": "date", "example": "2026-08-14" },
          "descricao": { "type": "string", "example": "Almoço com a equipe" }
        }
      },
      "ResumoMensal": {
        "type": "object",
        "properties": {
          "mes": { "type": "string", "example": "2026-08" },
          "totalGeral": { "type": "number", "example": 350.4 },
          "totalPorCategoria": {
            "type": "object",
            "additionalProperties": { "type": "number" },
            "example": { "alimentacao": 200.4, "transporte": 150 }
          }
        }
      },
      "ErroResponse": {
        "type": "object",
        "properties": {
          "mensagem": { "type": "string", "example": "mensagem descrevendo o erro" }
        }
      }
    },
    "responses": {
      "ErroValidacao": {
        "description": "Requisição inválida (dados ausentes ou incorretos)",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErroResponse" } }
        }
      },
      "NaoAutenticado": {
        "description": "Token de autenticação ausente, inválido ou expirado",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErroResponse" } }
        }
      },
      "SemPermissao": {
        "description": "Usuário autenticado não tem permissão para acessar o recurso",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErroResponse" } }
        }
      },
      "NaoEncontrado": {
        "description": "Recurso não encontrado",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErroResponse" } }
        }
      },
      "Conflito": {
        "description": "Conflito com o estado atual do recurso",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErroResponse" } }
        }
      }
    }
  },
  "paths": {
    "/auth/registro": {
      "post": {
        "summary": "Registra um novo usuário",
        "tags": ["Autenticação"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RegistroInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário criado com sucesso",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Usuario" } }
            }
          },
          "400": { "$ref": "#/components/responses/ErroValidacao" },
          "409": { "$ref": "#/components/responses/Conflito" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Autentica um usuário e retorna um token JWT",
        "tags": ["Autenticação"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginInput" } }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado com sucesso",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/TokenResponse" } }
            }
          },
          "400": { "$ref": "#/components/responses/ErroValidacao" },
          "401": { "$ref": "#/components/responses/NaoAutenticado" }
        }
      }
    },
    "/despesas": {
      "post": {
        "summary": "Cadastra uma nova despesa do usuário autenticado",
        "tags": ["Despesas"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/DespesaInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Despesa criada com sucesso",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Despesa" } }
            }
          },
          "400": { "$ref": "#/components/responses/ErroValidacao" },
          "401": { "$ref": "#/components/responses/NaoAutenticado" }
        }
      },
      "get": {
        "summary": "Lista as despesas do usuário autenticado",
        "tags": ["Despesas"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "categoria",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["alimentacao", "transporte", "moradia", "saude", "lazer", "educacao", "outros"]
            }
          },
          {
            "name": "mes",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "example": "2026-08" }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de despesas do usuário",
            "content": {
              "application/json": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Despesa" } }
              }
            }
          },
          "401": { "$ref": "#/components/responses/NaoAutenticado" }
        }
      }
    },
    "/despesas/resumo": {
      "get": {
        "summary": "Retorna o resumo mensal de gastos por categoria",
        "tags": ["Despesas"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "mes",
            "in": "query",
            "required": true,
            "schema": { "type": "string", "example": "2026-08" }
          }
        ],
        "responses": {
          "200": {
            "description": "Resumo mensal calculado com sucesso",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ResumoMensal" } }
            }
          },
          "400": { "$ref": "#/components/responses/ErroValidacao" },
          "401": { "$ref": "#/components/responses/NaoAutenticado" }
        }
      }
    },
    "/despesas/{id}": {
      "get": {
        "summary": "Consulta uma despesa pelo id",
        "tags": ["Despesas"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Despesa encontrada",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/Despesa" } }
            }
          },
          "401": { "$ref": "#/components/responses/NaoAutenticado" },
          "403": { "$ref": "#/components/responses/SemPermissao" },
          "404": { "$ref": "#/components/responses/NaoEncontrado" }
        }
      },
      "delete": {
        "summary": "Exclui uma despesa pelo id",
        "tags": ["Despesas"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "204": { "description": "Despesa excluída com sucesso" },
          "401": { "$ref": "#/components/responses/NaoAutenticado" },
          "403": { "$ref": "#/components/responses/SemPermissao" },
          "404": { "$ref": "#/components/responses/NaoEncontrado" }
        }
      }
    }
  }
}
